{
  "name": "execute-code-tails",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "COLLECTOR", "class_name": "Collector" }]
