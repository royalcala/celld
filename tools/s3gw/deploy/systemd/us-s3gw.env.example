# us-s3gw configuration + credentials — keep this file OUT of git (mode 0600).
#
# System install: /etc/us-s3gw/us-s3gw.env
# User install:   ~/.config/us-s3gw/us-s3gw.env

S3GW_HOST=127.0.0.1
S3GW_PORT=9020

# Dedicated filesystem (F0: RAID1). System default /var/lib/us-s3gw,
# user unit default %h/us-s3gw-data (overridden here when set).
S3GW_ROOT=/var/lib/us-s3gw

# One static key pair; these are the celld AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3GW_ACCESS_KEY=change-me
S3GW_SECRET_KEY=change-me

# Backup (deploy/backup.sh, used by us-s3gw-backup.service). Leave S3GW_MIRROR /
# S3GW_SNAPSHOTS unset to skip that side.
S3GW_MIRROR=/srv/us-s3gw-mirror
S3GW_SNAPSHOTS=/srv/us-s3gw-snapshots
S3GW_RETAIN=7
# 1 = stop the service for a quiesced snapshot (safest); 0 = online rsync.
S3GW_QUIESCE=0
S3GW_SYSTEMD_SCOPE=system
